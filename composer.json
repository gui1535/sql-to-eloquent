{
    "name": "sql-to-eloquent/sql-to-eloquent",
    "description": "Gera artefatos Laravel a partir de schemas SQL MySQL/MariaDB",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SqlToEloquent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SqlToEloquent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SqlToEloquent\\ProvedorServico"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
